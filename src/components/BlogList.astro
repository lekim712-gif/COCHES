---
import Base from '../layouts/Base.astro';
import { urlOf, type Article } from '../lib/articles';
const { items, page, pages } = Astro.props as { items: Article[]; page: number; pages: number };
const fmt = (s: string) => new Date(s).toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric' });
const href = (n: number) => (n === 1 ? '/blog/' : `/blog/pagina/${n}/`);
const title = page === 1 ? 'Blog del coche: comparativas, consejos y guías' : `Blog del coche, página ${page}`;
const desc = 'Blog del coche: comparativas, guías de compra, consejos de uso y mantenimiento explicados con claridad para propietarios y futuros compradores.';
---
<Base title={title} description={desc}>
  <div class="wrap">
    <h1>Blog del coche</h1>
    <p class="lead">Comparativas, guías de compra y consejos para sacar partido a tu coche, sin rodeos y con cifras orientativas.</p>
    <ul class="cards">{items.map((a) => <li><a href={urlOf(a)}><span class="code ttl">{a.data.name}</span><span>{a.data.seo.meta_description}</span><span class="meta">{fmt(a.data.datePublished)}</span></a></li>)}</ul>
    {pages > 1 && <nav class="pager" aria-label="Paginación del blog">
      {page > 1 && <a href={href(page - 1)} rel="prev">← Anteriores</a>}
      <span>Página {page} de {pages}</span>
      {page < pages && <a href={href(page + 1)} rel="next">Siguientes →</a>}
    </nav>}
  </div>
</Base>
