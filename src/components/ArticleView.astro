---
import Base from '../layouts/Base.astro';
import AdSlot from './AdSlot.astro';
import Affiliate from './Affiliate.astro';
import { SITE, CATEGORIES } from '../config';
import { urlOf, resolveRelated, type Article } from '../lib/articles';
const { article, all, crumbs, extraLinks = [] } = Astro.props as { article: Article; all: Article[]; crumbs: [string, string][]; extraLinks?: Article[] };
const d = article.data;
const parts = d.content_html.split(/<!--ad-slot-[12]-->/);
const related = [...resolveRelated(all, d.related), ...extraLinks].filter((a) => a.id !== article.id);
const site = Astro.site!;
const img = d.featured_image;
const ogImg = img?.replace(/\.webp$/, '.jpg');
const slugify = (t: string) => t.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/<[^>]+>/g, '').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
const addIds = (h: string) => d.type === 'guia' ? h.replace(/<h2>(.*?)<\/h2>/g, (_m, t) => `<h2 id="${slugify(t)}">${t}</h2>`) : h;
const tocItems = d.type === 'guia' ? [...(parts[0] + (parts[1] ?? '')).matchAll(/<h2>(.*?)<\/h2>/g)].map((m) => ({ t: m[1].replace(/<[^>]+>/g, ''), id: slugify(m[1]) })).filter((x) => x.t !== 'Ficha técnica') : [];
const introEnd = parts[0].indexOf('</p>') + 4;
const head = parts[0].slice(0, introEnd), rest = addIds(parts[0].slice(introEnd)), rest2 = addIds(parts[1] ?? '');
const url = new URL(urlOf(article), site).href;
const orgId = new URL('/#organization', site).href;
const reviewed = d.reviewed_by ? { name: d.reviewed_by, at: d.reviewed_at } : null;
const fmt = (s: string) => new Date(s).toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric' });
const jsonLd = [
  { '@type': 'Article', '@id': `${url}#article`, headline: d.name.slice(0, 110), description: d.seo.meta_description, datePublished: d.datePublished, dateModified: d.dateModified, ...(ogImg ? { image: new URL(ogImg, site).href } : {}), ...(reviewed ? { reviewedBy: { '@type': 'Person', name: reviewed.name, url: new URL('/autores/revisor-tecnico/', site).href } } : {}), inLanguage: SITE.lang, mainEntityOfPage: url, author: { '@id': orgId }, publisher: { '@id': orgId } },
  { '@type': 'BreadcrumbList', itemListElement: crumbs.map(([n, h], i) => ({ '@type': 'ListItem', position: i + 1, name: n, item: new URL(h, site).href })) },
  { '@type': 'FAQPage', mainEntity: d.schema_faq.map((q) => ({ '@type': 'Question', name: q.question, acceptedAnswer: { '@type': 'Answer', text: q.answer } })) },
];
---
<Base title={d.seo.meta_title} description={d.seo.meta_description} type="article" noindex={!reviewed && (d.needs_review || !SITE.indexUnreviewed)} modified={d.dateModified} published={d.datePublished} image={ogImg} jsonLd={jsonLd}>
  <div class="wrap article-wrap">
    <nav class="crumbs" aria-label="Migas de pan"><ol>{crumbs.map(([n, h], i) => <li>{i < crumbs.length - 1 ? <a href={h}>{n}</a> : <span aria-current="page">{n}</span>}</li>)}</ol></nav>
    <article class="article">
      <Fragment set:html={head} />
      {reviewed && <p class="byline">Revisado por <a href="/autores/revisor-tecnico/">{reviewed.name}</a>, mecánico{SITE.reviewer.years > 0 && <> con {SITE.reviewer.years} años de experiencia</>} · Actualizado el <time datetime={d.dateModified}>{fmt(d.dateModified)}</time></p>}
      {img && <figure class="hero-img"><img src={img} width="1200" height="630" alt={`Imagen ilustrativa: ${d.name}`} fetchpriority="high" decoding="async" /></figure>}
      {tocItems.length >= 5 && <nav class="toc" aria-label="Contenido de la guía"><p class="toc-t">En esta guía</p><ol>{tocItems.map((x) => <li><a href={`#${x.id}`}>{x.t}</a></li>)}</ol></nav>}
      <Fragment set:html={rest} />
      <AdSlot n={1} />
      <Fragment set:html={rest2} />
      <AdSlot n={2} />
      <section class="faq" aria-labelledby="faq-h">
        <h2 id="faq-h">Preguntas frecuentes</h2>
        {d.schema_faq.map((q) => <div class="qa"><h3>{q.question}</h3><p>{q.answer}</p></div>)}
      </section>
      <Affiliate products={d.products} />
      {related.length > 0 && (
        <section class="related" aria-labelledby="rel-h">
          <h2 id="rel-h">También te puede interesar</h2>
          <ul>{related.map((a) => <li><a href={urlOf(a)}>{a.data.name}</a></li>)}</ul>
        </section>
      )}
      <p class="meta">Última actualización: <time datetime={d.dateModified}>{fmt(d.dateModified)}</time> · <a href="/metodologia/">Cómo elaboramos las fichas</a></p>
      {reviewed
        ? <p class="meta disclaimer"><strong>Revisada por <a href="/autores/revisor-tecnico/">{reviewed.name}</a></strong>{reviewed.at && <> el <time datetime={reviewed.at}>{fmt(reviewed.at)}</time></>}, mecánico. Ficha elaborada con ayuda de inteligencia artificial. Información orientativa: no sustituye al manual de taller ni a un profesional.</p>
        : <p class="meta disclaimer">Ficha elaborada con ayuda de inteligencia artificial y controles automáticos de estructura; <strong>pendiente de revisión técnica</strong>. Es información orientativa: no sustituye al manual de taller ni a un profesional.</p>}
    </article>
  </div>
</Base>
