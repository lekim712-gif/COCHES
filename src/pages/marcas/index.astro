---
import Base from '../../layouts/Base.astro';
import { allArticles, brands } from '../../lib/articles';
const list = brands(await allArticles());
---
<Base title="Códigos de avería por marca de coche | CodigoAveria" description="Fichas de diagnóstico OBD2 por marca: Grupo VAG, Grupo PSA, Renault y más, con las particularidades de cada plataforma.">
  <div class="wrap">
    <h1>Códigos de avería por marca</h1>
    <p class="lead">Solo publicamos una ficha de marca cuando aporta información propia de esa plataforma. Si no, la ficha genérica del código es la referencia.</p>
    <ul class="cards">{list.map((b) => <li><a href={`/marcas/${b.slug}/`}><span class="code">{b.name.split(' (')[0]}</span><span>{b.items.length} {b.items.length === 1 ? 'ficha' : 'fichas'}: {b.items.map((i) => i.data.code).join(', ')}</span></a></li>)}</ul>
  </div>
</Base>
