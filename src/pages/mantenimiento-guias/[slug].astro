---
import ArticleView from '../../components/ArticleView.astro';
import { allArticles, byType, urlOf } from '../../lib/articles';
export async function getStaticPaths() {
  const all = await allArticles();
  return byType(all, 'guia').map((a) => ({ params: { slug: a.data.seo.slug }, props: { a } }));
}
const { a } = Astro.props;
const all = await allArticles();
---
<ArticleView article={a} all={all} crumbs={[['Inicio', '/'], ['Mantenimiento', '/mantenimiento-guias/'], [a.data.name, urlOf(a)]]} />
