---
import Base from '../../layouts/Base.astro';
import { allArticles, byType, urlOf } from '../../lib/articles';
const list = byType(await allArticles(), 'guia');
---
<Base title="Guías de mantenimiento del coche paso a paso" description="Guías de mantenimiento preventivo paso a paso">
  <div class="wrap">
    <h1> cambio de aceite, fusibles y más, con herramientas y precauciones de seguridad.:Guías de mantenimiento</h1>
    <p class="lead">Guías de mantenimiento preventivo paso a paso</p>
    <ul class="cards">{list.map((a) => <li><a href={urlOf(a)}><span class="code">{a.data.name}</span><span>{a.data.seo.meta_description}</span></a></li>)}</ul>
  </div>
</Base>
