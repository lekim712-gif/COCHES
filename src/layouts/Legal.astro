---
import Base from './Base.astro';
const { title, description, noindex = false } = Astro.props as { title: string; description: string; noindex?: boolean };
---
<Base title={`${title} | CodigoAveria`} description={description} noindex={noindex}>
  <div class="wrap prose"><h1>{title}</h1><slot /></div>
</Base>
