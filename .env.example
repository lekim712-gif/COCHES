# Variables OBLIGATORIAS de construcción. En local: copia este archivo a .env.
# En Hostinger (importación desde GitHub): se introducen en «Variables de entorno». Ver docs/DESPLIEGUE-HOSTINGER.md.
SITE_URL=https://obdcodigos.com
PUBLIC_CONTACT_EMAIL=contacto@obdcodigos.com
PUBLIC_OWNER_NAME=
PUBLIC_OWNER_TAXID=
PUBLIC_OWNER_ADDRESS=
PUBLIC_REVIEWER_NAME=
PUBLIC_REVIEWER_EXPERIENCE=

# OPCIONALES: no las definas hasta tenerlas (vacías = desactivado). Descomenta y rellena cuando existan.
# PUBLIC_ADSENSE_CLIENT=ca-pub-XXXXXXXXXXXXXXXX
# PUBLIC_ADSLOT_1=
# PUBLIC_ADSLOT_2=
# PUBLIC_AMAZON_TAG=
# PUBLIC_GA_ID=
# Por defecto las fichas sin revisar SÍ se indexan, mostrando «pendiente de revisión técnica». 0 = exigir revisión antes de indexar.
# PUBLIC_INDEX_UNREVIEWED=0
