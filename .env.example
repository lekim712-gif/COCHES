# Copia a .env para construir en local. Para el despliegue automático, estos mismos valores van como secretos de GitHub (ver docs/DESPLIEGUE-HOSTINGER.md).
SITE_URL=https://obdcodigos.com
PUBLIC_CONTACT_EMAIL=contacto@obdcodigos.com
PUBLIC_OWNER_NAME=
PUBLIC_OWNER_TAXID=
PUBLIC_OWNER_ADDRESS=
# Se rellenan cuando AdSense/Amazon aprueben la cuenta (hasta entonces no se carga ningún anuncio)
PUBLIC_ADSENSE_CLIENT=
PUBLIC_ADSLOT_1=
PUBLIC_ADSLOT_2=
PUBLIC_AMAZON_TAG=
PUBLIC_GA_ID=
# 1 = indexar también las fichas sin revisar (por defecto no: llevan noindex hasta que se marcan como revisadas)
PUBLIC_INDEX_UNREVIEWED=
